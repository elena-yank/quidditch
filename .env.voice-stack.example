POSTGRES_DB=quidditch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/quidditch
PUBLIC_HOST=quidditch.aurorhq.ru
# Voice/WebRTC ICE server configuration.
# STUN is used for direct P2P connections; TURN is a relay for users behind NAT.
# If these are left commented out, the server will fall back to reading turnserver.conf.
# NOTE: The fallback only provides TURN (no STUN), so uncommenting STUN here is recommended.
VOICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# VOICE_TURN_URLS=turn:quidditch.aurorhq.ru:3478?transport=udp,turn:quidditch.aurorhq.ru:3478?transport=tcp,turns:quidditch.aurorhq.ru:5349?transport=tcp
# VOICE_TURN_USERNAME=kwidditch
# VOICE_TURN_CREDENTIAL=change-me-now
